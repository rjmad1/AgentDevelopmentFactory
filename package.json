{
  "name": "agent-development-factory",
  "version": "0.5.0",
  "type": "module",
  "private": true,
  "description": "Agent Development Factory: Bounded authoring engine, verifiable evidence ledger, and parallel agent pipeline",
  "scripts": {
    "test": "node test/runner.js",
    "lint": "node scripts/lint-contracts.js",
    "docs:gen": "node scripts/generate-api-docs.js",
    "eval": "node test/evals/runner.js",
    "packet:critic": "node scripts/bundle-critic-packet.js",
    "packet:verifier": "node scripts/bundle-verifier-packet.js",
    "packet:doc": "node scripts/bundle-doc-packet.js",
    "packets": "npm run packet:critic && npm run packet:verifier && npm run packet:doc",
    "ci": "node test/runner.js && node scripts/lint-contracts.js && node test/evals/runner.js && node src/cli.js redteam && node scripts/generate-api-docs.js",
    "watch": "node scripts/autonomous-loop.js",
    "auto": "node scripts/autonomous-loop.js --once",
    "setup:hooks": "node scripts/setup-hooks.js",
    "doctor": "node src/cli.js doctor",
    "maturity": "node scripts/evaluate-product-maturity.js",
    "ui": "node src/cli.js ui",
    "eval:judge": "node src/cli.js eval-judge",
    "guardrails:audit": "node src/cli.js guardrails audit",
    "guardrails:verify": "node src/cli.js guardrails verify",
    "redteam": "node src/cli.js redteam",
    "redteam:py": "python scripts/run_redteam.py",
    "benchmark": "python scripts/run_laya_eval_judge.py",
    "trace": "node src/cli.js trace",
    "scale": "node src/cli.js scale",
    "scale:simulate": "node src/cli.js scale --action simulate",
    "heal": "node src/cli.js heal",
    "sync": "node src/cli.js sync",
    "sync:reconcile": "node src/cli.js sync --action reconcile"
  }
}
